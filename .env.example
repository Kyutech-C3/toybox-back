# 動作環境の指定、devかprodを指定
ENV=dev

# フロントエンドのURL、カンマ区切りで複数指定可能
FRONTEND_URL=http://localhost:3000

# appコンテナから接続するPostgreSQL
DB_DSN=postgres://postgres:password@db:5432/toybox?sslmode=disable
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_HOST=db
POSTGRES_DB=toybox

# S3の設定、localstackを仕様する場合はそのまま
# バケット名
S3_BUCKET=toybox
# アセットの保存先ディレクトリ
S3_DIR=assets
S3_BASE_URL=http://s3.us-east-1.localhost.localstack.cloud:4566
REGION_NAME=us-east-1
ACCESS_KEY=test
SECRET_ACCESS_KEY=test

# Discord Developer Portalから取得、持ってない場合は任意の人からもらう
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# 認証を許可するサーバーのID、カンマ区切りで複数指定可能(GUILDは旧称)
DISCORD_GUILD_IDS=
# Discord認証終了後のリダイレクト先指定、フロントエンドがある場合はそちらを指定しても可
REDIRECT_URL=http://localhost:8080/auth/discord/callback

# JWTトークンの秘密鍵、デフォルト値は開発環境専用なので実運用では十分に長いランダム値へ変更する
TOKEN_SECRET=local-development-only-secret