# 動作環境の指定、devかprodを指定
ENV=dev

# フロントエンドのURL、カンマ区切りで複数指定可能、/なし、先頭はToyBoxフロント指定
FRONTEND_URL=http://localhost:5173

# appコンテナから接続するPostgreSQL
DB_DSN=postgres://postgres:password@db:5432/toybox?sslmode=disable
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_HOST=db
POSTGRES_DB=toybox
# 旧DB移行時(scripts/movedata.sh)にのみ使用する、移行元DB(再現用コンテナ)への接続情報
DB_DSN_BACKUP=postgres://postgres:password@migration-source-db:5432/toybox?sslmode=disable

# S3の設定、localstackを仕様する場合はそのまま
# バケット名
S3_BUCKET=toybox
# アセットの保存先ディレクトリ
S3_DIR=assets
S3_BASE_URL=http://s3.us-east-1.localhost.localstack.cloud:4566
REGION_NAME=us-east-1
ACCESS_KEY=test
SECRET_ACCESS_KEY=test

# 旧ToyBoxの公開APIへ一時的にプロキシするための接続先（http/httpsのscheme必須）
LEGACY_TOYBOX_BASE_URL=
# 接続先がvirtual hostを要求する場合のみ指定。未指定時はBASE_URLのhostを使用
LEGACY_TOYBOX_PROXY_HOST=

# AuthenticatorのURL。起動時と検証失敗時に /.well-known/jwks.json から公開鍵を取得する
AUTHENTICATOR_URL=http://authenticator:8081

# Discordの作品広場に投稿するWebhookのURL
WEBHOOK_URL=